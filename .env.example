
HARNESS=pi
# Subscription-backed harness auth. Production path: point at a keychain
# credential id (the login lives encrypted in its owner's keychain; core
# refreshes it centrally and hands harnesses ephemeral derived material).
#CODEX_AUTH_CREDENTIAL=
#CLAUDE_AUTH_CREDENTIAL=
# Local-dev fallback only: a Codex CLI auth.json on this machine
# (defaults to ~/.codex/auth.json when HARNESS=codex). Not allowed in production.
CODEX_AUTH_FILE=
HARNESS_SECURITY_POSTURE=auto
NODE_ENV=development
NPM_INSTALL_REGISTRY=https://registry.npmjs.org
SANDBOX_BACKEND=local
LOCAL_SANDBOX_EGRESS_PROXY_URL=
LOCAL_SANDBOX_LIFECYCLE_MODE=enforce
LOCAL_SANDBOX_LEASE_TTL_MS=900000
LOCAL_SANDBOX_MIGRATION_WAIT_MS=300000
LOCAL_SANDBOX_LEGACY_OBSERVE_MS=10000
DEEP_IDLE_MACHINE_MS=259200000
DEV_IDLE_MACHINE_MS=7200000
# docker network inspect bridge --format '{{(index .IPAM.Config 0).Gateway}}'
QM_EGRESS_BIND_ADDRESS=127.0.0.1
COMPOSE_PROFILES=
HARNESS_SHARING_POSTURE=isolated

#ANTHROPIC_API_KEY=sk-ant-...
#OPENAI_API_KEY=sk-...
#OPENROUTER_API_KEY=sk-or-...

ORG_ID=acme
PORT=8080
QM_BIND_ADDRESS=127.0.0.1
QM_INTERNAL_BIND_ADDRESS=127.0.0.1
QM_POSTGRES_PORT=5432
# Group id of the host Docker socket, so core can drive the local sandbox:
# stat -c %g /var/run/docker.sock
DOCKER_GID=
QM_ADMIN_PORT=8090
QM_WEB_UI_PORT=8096
QM_PORTAL_PORT=8097
QM_AUTH_PORT=8099
QM_HTTP_PORT=8088

# Local Docker Compose Postgres settings. Generate a unique password before starting:
# openssl rand -hex 32
POSTGRES_USER=qm
POSTGRES_DB=qm
POSTGRES_PASSWORD=

#ORG_BRAND_SELF_LABEL=straylight
#ORG_BRAND_ORG_NAME=Acme Corp
#ORG_BRAND_ACCENT=#4f46e5
#ORG_BRAND_MARK=S

#SLACK_BOT_TOKEN=xoxb-...
#SLACK_APP_TOKEN=xapp-...
#SLACK_BOT_DISPLAY_NAME=straylight
#SLACK_BOT_ICON_EMOJI=:robot_face:

CORE_SIGNING_SECRET=
CAPABILITY_SECRET=
PORTAL_IDENTITY_SECRET=
PORTAL_SESSION_SECRET=
CONNECTOR_SECRET_KEY=
WEB_UI_IM_CREDENTIALS_KEY=
# 1 = all, 0 = none, or comma-separated: wechat,wecom,feishu,qq,dingtalk
WEB_UI_CHAT_CHANNELS_ENABLED=1
SKILL_SIGNING_SECRET=

PORTAL_PUBLIC_URL=http://localhost:8088
PORTAL_LOCAL_AUTH_BYPASS=1
PORTAL_DEPLOYMENTS_ENABLED=1
PORTAL_DEV_PRINCIPAL=dev-admin
PORTAL_XFF_TRUSTED_HOPS=1
ADMIN_GRANTS=
WEB_UI_PRINCIPALS=

OIDC_AUTH_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_USERINFO_ENDPOINT=
OIDC_ISSUER=
OIDC_JWKS_URI=
OIDC_SCOPES=openid email profile
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PRINCIPAL_CLAIM=email
OIDC_ALLOWED_EMAIL_DOMAIN=example.com
OIDC_ALLOWED_EMAILS=
PORTAL_EXPECTED_TEAM_ID=
AUTH_BROKER_UPSTREAM=
AUTH_BROKER_PREFIX=/idp

AUTH_WECOM_CORP_ID=
AUTH_WECOM_AGENT_ID=
AUTH_WECOM_SECRET=
AUTH_WECOM_DIRECTORY_SYNC_SECRET=
AUTH_WECOM_REDIRECT_URI=
AUTH_WECOM_NAME=WeCom
AUTH_WECOM_LOGIN_ENABLED=1
AUTH_WECOM_SYNC_ENABLED=0
AUTH_WECOM_JIT_PROVISIONING_ENABLED=0
AUTH_WECOM_SYNC_MINUTES=360
AUTH_WECOM_MATCH_POLICY=verified_corporate_email

AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URI=
AUTH_SIGNING_JWK=
AUTH_TOKEN_SECRET=
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_EMAIL_DOMAIN=example.com
AUTH_EMAIL_FROM=
AUTH_BRAND_NAME=qm
AUTH_EMAIL_TRANSPORT=resend
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls

RATE_LIMIT_PER_WINDOW=60
RATE_LIMIT_WINDOW_MS=60000
BUDGET_USD_PER_WINDOW=25
ORG_BUDGET_USD_PER_WINDOW=100
BUDGET_WINDOW_MS=86400000

# Extra root CA (PEM content) trusted for the Postgres connection, for providers that pin a private root. Optional; verification stays on. (core)
# DATABASE_CA_CERT=

# Defaults resolved once for each new swarm; initial spawn may override these.
# SWARM_DEFAULTS={"agents":32,"turnMs":600000}
SLACK_CONTEXT_SOURCE=live
SLACK_HISTORY_LIMIT=
