QM_INTERNAL_BIND_ADDRESS=127.0.0.1
QM_POSTGRES_PORT=5432
DOCKER_GID=999
QM_HTTP_PORT=8088

POSTGRES_USER=qm
POSTGRES_DB=qm
POSTGRES_PASSWORD=qm-example-postgres-password-00000000000000000000000000000000

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

